PORT=3000
NODE_ENV=development

JWT_ACCESS_SECRET=change_me_super_secret_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_super_secret_refresh
JWT_REFRESH_EXPIRES_IN=7d

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contentflow_ai
REDIS_URL=redis://localhost:6379
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

ENCRYPTION_SECRET=change-me-with-a-32-byte-secret-value
BCRYPT_ROUNDS=10

# OAuth / social placeholders
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/integrations/facebook/oauth/callback
META_OAUTH_BASE_URL=https://www.facebook.com/dialog/oauth

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/integrations/instagram/oauth/callback
INSTAGRAM_OAUTH_BASE_URL=https://api.instagram.com/oauth/authorize

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/integrations/tiktok/oauth/callback
TIKTOK_OAUTH_BASE_URL=https://www.tiktok.com/auth/authorize

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/youtube/oauth/callback
GOOGLE_OAUTH_BASE_URL=https://accounts.google.com/o/oauth2/v2/auth

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/integrations/linkedin/oauth/callback
LINKEDIN_OAUTH_BASE_URL=https://www.linkedin.com/oauth/v2/authorization

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/integrations/x/oauth/callback
X_OAUTH_BASE_URL=https://twitter.com/i/oauth2/authorize
